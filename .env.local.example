# LeadFlow environment variables
#
# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored. This template is committed and must never
# contain real values.
#
# Where to find them:
#   1. Create a project at https://supabase.com/dashboard
#   2. Project Settings → API
#   3. Copy "Project URL" and the "publishable key" (older projects call it
#      the "anon" / "public" key — it is the same client credential)
#
# Both values are public: they ship to the browser and are protected by Row
# Level Security, not by secrecy.
#
# NEVER add a service-role key here with a NEXT_PUBLIC_ prefix. That key
# bypasses RLS and would be readable by anyone who loads the app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Lead data provider — OpenStreetMap (Nominatim + Overpass)
# ---------------------------------------------------------------------------
#
# No API key is required. Both services are free public OSM APIs with fair-use
# policies, so nothing here is a secret. They are server-side variables purely
# so the endpoints and the identifying User-Agent can be changed without a code
# edit. Never add a NEXT_PUBLIC_ prefix to anything here.
#
# All three are optional — the defaults below are used when unset.
#
# Overpass and Nominatim both require a User-Agent that identifies the caller
# and a way to contact you. Set this to something real before deploying, or
# requests may be blocked. See the OSM usage policies:
#   https://operations.osmfoundation.org/policies/nominatim/
#   https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
LEAD_PROVIDER_USER_AGENT="LeadFlow/0.1 (prototype)"

# Point these at your own instances if you outgrow the public ones.
LEAD_PROVIDER_OVERPASS_URL="https://overpass-api.de/api/interpreter"
LEAD_PROVIDER_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"

# ---------------------------------------------------------------------------
# AI lead analysis — Anthropic Claude
# ---------------------------------------------------------------------------
#
# THIS ONE IS A REAL SECRET. It bills to your account, so:
#   * Never add a NEXT_PUBLIC_ prefix. That inlines the value into the browser
#     bundle and publishes it to every visitor.
#   * Never commit it. `.env.local` is gitignored; this template is not.
#   * On a hosting provider, set it as an environment variable in the project
#     settings rather than in a file.
#
# Get a key at https://console.anthropic.com/settings/keys
# Analysis is off until this is set; the Analyze button is replaced by a
# "not configured" notice rather than failing when pressed.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001 — a structured
# classification task over a handful of fields, which is what Haiku is priced
# for. Set this to a larger model only if analysis quality demands it: it is
# charged per lead analyzed.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
